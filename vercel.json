{
  "regions": ["fra1"],
  "ignoreCommand": "if [ \"$SKIP_PREVIEW_BUILDS\" = 1 ] && [ \"$VERCEL_GIT_COMMIT_REF\" != dev ] && [ \"$VERCEL_GIT_COMMIT_REF\" != main ]; then echo \"Preview builds off for this project\"; exit 0; fi; exit 1",
  "redirects": [
    { "source": "/impressum", "destination": "https://smartist.studio/impressum", "permanent": false },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "demo.smartist.studio" }],
      "destination": "https://app.smartist.studio/demo",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/auth/callback",   "destination": "/api?__path=/auth/callback" },

    { "source": "/",                "destination": "/app/index.html" },
    { "source": "/login",           "destination": "/app/index.html" },
    { "source": "/signup",          "destination": "/app/signup.html" },
    { "source": "/onboarding",      "destination": "/app/onboarding.html" },
    { "source": "/workspaces",      "destination": "/app/workspaces.html" },
    { "source": "/profile",         "destination": "/app/profile.html" },
    { "source": "/confirm-email",  "destination": "/app/confirm-email.html" },
    { "source": "/admin",           "destination": "/app/admin.html" },
    { "source": "/api/docs",        "destination": "/app/api-docs.html" },
    { "source": "/contact",         "destination": "/app/contact.html" },
    { "source": "/privacy",         "destination": "/app/privacy.html" },
    { "source": "/demo",            "destination": "/app/demo.html" },
    { "source": "/stage",           "destination": "/app/stage.html" },

    { "source": "/:slug/dashboard",        "destination": "/app/dashboard.html" },
    { "source": "/:slug/songs",            "destination": "/app/songs.html" },
    { "source": "/:slug/setlist",          "destination": "/app/setlist.html" },
    { "source": "/:slug/setlist-history",  "destination": "/app/setlist-history.html" },
    { "source": "/:slug/gigs",             "destination": "/app/gigs.html" },
    { "source": "/:slug/venues",           "destination": "/app/venues.html" },
    { "source": "/:slug/organizers",       "destination": "/app/organizers.html" },
    { "source": "/:slug/hub",              "destination": "/app/hub.html" },
    { "source": "/:slug/pro-import",       "destination": "/app/pro-import.html" },
    { "source": "/:slug/song-import",      "destination": "/app/song-import.html" },
    { "source": "/:slug/profile",          "destination": "/app/profile.html" },
    { "source": "/:slug/settings",         "destination": "/app/settings.html" },
    { "source": "/:slug/stage",            "destination": "/app/stage.html" },
    { "source": "/:slug/contact",          "destination": "/app/contact.html" },

    { "source": "/:slug",           "destination": "/app/dashboard.html" },

    { "source": "/api/:path*",      "destination": "/api?__path=/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "0" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/((?!api/docs$).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src https:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/api/docs",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.72.3/dist/browser/standalone.js; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src https:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/app/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/app/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}

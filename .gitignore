/.idea
.DS_Store
.env
.env.local
.env*.local
node_modules/
.vercel
logs/
.claude/*
# Shared agent setup is committed; personal settings stay local.
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
data/
.superpowers/

# docs/ holds published documentation only — the repository is public.
# Working plans, specs, reviews and notes go to docs/plans/ and stay local;
# everything else in docs/ is ignored unless listed here. A new published doc
# gets its own line.
docs/*
!docs/agents.md
!docs/architecture.md
!docs/ci-cd.md
!docs/deployment.md
!docs/oauth-setup.md
!docs/reference.md
!docs/tenant-onboarding.md

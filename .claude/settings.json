{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run dev:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(bash scripts/dev_up.sh *)",
      "Bash(node tests/*)",
      "Bash(node scripts/apply_schema.js --check)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)"
    ],
    "ask": [
      "Bash(node scripts/apply_schema.js*)",
      "Bash(node scripts/create_user.js*)",
      "Bash(node scripts/plans.js*)",
      "Bash(node scripts/seed.js*)",
      "Bash(node scripts/import_*)",
      "Bash(node scripts/demo_reset.js*)",
      "Bash(node scripts/setup.js*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push -f origin main*)",
      "Bash(node scripts/delete_artist.js*)",
      "Bash(vercel env*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel promote*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}

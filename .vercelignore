# Files to ignore during Vercel deployment
# The build step (scripts/deploy_migrate.js) needs these four; the other
# scripts stay out of the deployment.
scripts/*
!scripts/deploy_migrate.js
!scripts/apply_schema.js
!scripts/_lib.js
!scripts/schema.sql
tests/
.git/
.github/
.idea/
CLAUDE.md
DATABASE.md
README.md
# Documentation and agent setup are for the repository, not the web.
docs/
.claude/
AGENTS.md

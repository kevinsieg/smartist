# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Per-environment: use the Neon `dev` branch URL locally and in Vercel Preview;
# use the Neon `main` branch URL in Vercel Production.
DATABASE_URL=postgresql://user:password@host/dbname

# Slug of the artist row in the `artists` table — identifies which artist this
# deployment serves. Created by `node scripts/setup.js` during onboarding.
ARTIST_SLUG=yourband

# ── Required for app behaviour ────────────────────────────────────────────────

# Password-reset magic links are sent to this origin.
# Per-environment: production domain in Production; stable Vercel Preview URL in Preview.
APP_ORIGIN=https://yourband.example.com

# The only email address that can receive a magic login link (password reset).
# Per-environment: use a +dev alias (e.g. you+dev@yourdomain.com) in Preview
# to keep dev login emails separate from production ones.
ARTIST_ADMIN_EMAIL=you@yourdomain.com

# ── File storage (Cloudflare R2) ───────────────────────────────────────────────
# Create a bucket at dash.cloudflare.com → R2, then generate an API token
# with Object Read & Write permissions. Enable public access on the bucket.
#
# Per-environment: use a separate bucket (e.g. yourband-dev) in Preview/Development
# so dev file uploads are isolated from production objects.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yourband
R2_PUBLIC_URL=https://<bucket>.<accountid>.r2.dev

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Get a key at resend.com. Verify your sending domain first.
# Shared across all environments — mark "All Environments" in Vercel dashboard.
# To switch provider: update the PROVIDER config block in api/_email.js

RESEND_API_KEY=re_...
RESEND_FROM=noreply@yourdomain.com

# ── AI lyrics suggest (Google Gemini — free: 1 500 req/day, no billing needed) ─
# Get a free API key at aistudio.google.com → Get API key.
# Shared across all environments — mark "All Environments" in Vercel dashboard.
# To switch provider: update the AI config block in api/_ai.js

GEMINI_API_KEY=AIza...

# ── Logging (Better Stack — free tier available) ──────────────────────────────
# Create a source at betterstack.com/logs → Sources → Connect source.
# Production-only: set only in Vercel Production environment. Leave empty
# in Preview/Development — preview logs go to Vercel function stdout instead.
# To switch provider: update the TRANSPORT config block in api/_logger.js

BETTERSTACK_TOKEN=

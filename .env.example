# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use the pooled URL from your Neon project.
# Per-environment: Neon `dev` branch for Development/Preview, `main` for Production.

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Artist identity ────────────────────────────────────────────────────────────
# Slug of the artist row in the `artists` table — identifies which artist this
# deployment serves. Created by `node scripts/setup.js` during onboarding.
# Must match the `slug` column exactly.

ARTIST_SLUG=yourband

# ── App origin ─────────────────────────────────────────────────────────────────
# Base URL of this deployment — used in magic-link password-reset emails.
# Development: http://localhost:3000
# Preview:     your stable Vercel preview URL, e.g. https://smartist-foo.vercel.app
# Production:  your custom domain, e.g. https://smartist.yourdomain.com

APP_ORIGIN=https://yourband.example.com

# ── Admin email ────────────────────────────────────────────────────────────────
# The only address that can receive a magic login link (password reset).
# Use a +dev alias in Preview/Development to separate dev emails from production.

ARTIST_ADMIN_EMAIL=you@yourdomain.com

# ── File storage (Cloudflare R2) ───────────────────────────────────────────────
# Create a bucket at dash.cloudflare.com → R2. Enable public access on the bucket.
# Generate an API token with Object Read & Write on that bucket.
# Per-environment: use a separate bucket for Preview/Development (e.g. yourband-dev)
# so dev uploads don't mix with production files.
# R2_PUBLIC_URL: the public bucket URL shown in the R2 dashboard after enabling access.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yourband
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Transactional email (Resend) ───────────────────────────────────────────────
# Get a key at resend.com → API Keys. Verify your sending domain first.
# RESEND_FROM must use a verified domain or Resend will reject the send.
# CONTACT_EMAIL: where contact-form submissions go; defaults to ARTIST_ADMIN_EMAIL.
# These can be the same across all environments — set as "All Environments" in Vercel.

RESEND_API_KEY=re_...
RESEND_FROM=noreply@yourdomain.com
# CONTACT_EMAIL=you@yourdomain.com

# ── AI lyrics suggest ──────────────────────────────────────────────────────────
# Default provider: Google Gemini (free: 1 500 req/day, no billing required).
# Get a free key at aistudio.google.com → Get API key.
# To switch provider: update the AI config block in api/_ai.js and set the
# corresponding key below instead.

GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...

# ── OAuth login (optional) ─────────────────────────────────────────────────────
# Login buttons appear only when both variables for a provider are set.
# Leave unset to disable OAuth entirely — password login still works.
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
#   Create OAuth 2.0 client ID → add <APP_ORIGIN>/auth/callback as redirect URI.
#
# Facebook: developers.facebook.com → Create App →
#   add <APP_ORIGIN>/auth/callback as valid OAuth redirect URI.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ── Logging (Better Stack) ─────────────────────────────────────────────────────
# Production only — do NOT set this in local .env or Development/Preview environments.
# Local logs write to logs/ automatically. Preview logs go to Vercel function stdout.
# Create a source at betterstack.com/logs → Sources → Connect source.
# To switch provider: update the TRANSPORT config block in api/_logger.js.

# BETTERSTACK_TOKEN=

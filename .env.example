# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host/dbname

# Slug of the band row in the `bands` table — identifies which band this
# deployment serves. Created by `node scripts/setup.js` during onboarding.
BAND_SLUG=yourband

# ── Required for the band tools app ───────────────────────────────────────────

# Password-reset magic links are sent to this origin. Set to your deployment URL.
APP_ORIGIN=https://yourband.example.com

# ── File storage (Cloudflare R2 — free tier: 10 GB, no egress fees) ───────────
# Create a bucket at dash.cloudflare.com → R2, then generate an API token
# with Object Read & Write permissions. Enable public access on the bucket.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://<bucket>.<accountid>.r2.dev

# ── Transactional email (Resend — free tier: 100 emails/day) ─────────────────
# Get a key at resend.com. Verify your sending domain first.
# To switch provider: update the PROVIDER config block in api/_email.js

RESEND_API_KEY=re_...
RESEND_FROM=noreply@yourdomain.com

# ── AI lyrics suggest (Google Gemini — free: 1 500 req/day, no billing needed) ─
# Get a free API key at aistudio.google.com → Get API key.
# To switch provider: update the AI config block in api/_ai.js

GEMINI_API_KEY=AIza...

# ── Logging (Better Stack — free tier available) ──────────────────────────────
# Create a source at betterstack.com/logs → Sources → Connect source.
# Leave empty to log to stdout only (fine for development / small deployments).
# To switch provider: update the TRANSPORT config block in api/_logger.js

BETTERSTACK_TOKEN=
